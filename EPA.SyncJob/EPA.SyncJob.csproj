<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
      <PackageReference Include="Fanex.Data" Version="4.3.3" />
      <PackageReference Include="Fanex.Data.Repository" Version="4.3.3" />
      <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.3" />
      <PackageReference Include="Fanex.Logging.Extensions" Version="1.1.0" />
      <PackageReference Include="Fanex.Logging" Version="2.0.2" />
      <PackageReference Include="Fanex.Logging.Sentry.RavenClient" Version="2.0.2" />
      <PackageReference Include="NLog.Web.AspNetCore" Version="5.4.0" />
      <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.3" />
      <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.3" />
      <PackageReference Include="Cronos" Version="0.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.LOCAL.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\SpNames.KLDR.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\SpNames.LOCAL.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="App_Data\SpNames.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
